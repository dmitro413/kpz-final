<Window x:Class="KPZ_FINAL.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KPZ_FINAL"
        xmlns:views="clr-namespace:KPZ_FINAL.Views"
        xmlns:vm="clr-namespace:WpfLibrary.viewmodels;assembly=WpfLibrary"
        mc:Ignorable="d"
        Title="Minesweeper" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:GameViewModel}">
            <views:GameView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LeaderboardViewModel}">
            <views:LeaderboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameHistoryViewModel}">
            <views:GameHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AchievementViewModel}">
            <views:AchievementsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimeAttackViewModel}">
            <views:TimeAttackView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="12,8">
            <DockPanel>
                <TextBlock Text="💣 Minesweeper" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Game"
                            Command="{Binding ShowGameCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,0"/>
                    <Button Content="⏱ Time Attack"
                            Command="{Binding ShowTimeAttackCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,0"
                            FontFamily="Segoe UI Emoji"/>
                    <Button Content="History"
                            Command="{Binding ShowHistoryCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,0"/>
                    <Button Content="Leaderboard"
                            Command="{Binding ShowLeaderboardCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,0"/>
                    <Button Content="Achievements"
                            Command="{Binding ShowAchievementsCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,0"/>
                    <Button Content="Statistics"
                            Command="{Binding ShowStatisticsCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,0"/>
                    <Button Content="Settings"
                            Command="{Binding ShowSettingsCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            Margin="4,0"/>
                    

                    <Border Width="1" Background="#5CFFFFFF" Margin="8,4"/>

                    <Button Content="New Game"
                            Command="{Binding StartNewGameCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="4,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Background="{StaticResource SurfaceBrush}">
            <ContentControl Content="{Binding CurrentPage}" />
        </Grid>
    </DockPanel>
</Window>
