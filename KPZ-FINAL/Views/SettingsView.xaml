<UserControl x:Class="KPZ_FINAL.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WpfLibrary.models;assembly=WpfLibrary">

    <ScrollViewer Margin="24">
        <StackPanel MaxWidth="420" HorizontalAlignment="Left">

            <TextBlock Text="⚙️ Settings" FontSize="24" FontWeight="Bold"
                       FontFamily="Segoe UI Emoji"
                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,24"/>

            <TextBlock Text="Difficulty" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox SelectedValue="{Binding SelectedDifficulty}"
                      SelectedValuePath="Tag"
                      Margin="0,0,0,16">
                <ComboBoxItem Content="🧪 Ultra Easy (5×5, 1 міна)" Tag="{x:Static models:DifficultyLevel.UltraEasy}"/>
                <ComboBoxItem Content="Easy"                         Tag="{x:Static models:DifficultyLevel.Easy}"/>
                <ComboBoxItem Content="Medium"                       Tag="{x:Static models:DifficultyLevel.Medium}"/>
                <ComboBoxItem Content="Hard"                         Tag="{x:Static models:DifficultyLevel.Hard}"/>
                <ComboBoxItem Content="Custom"                       Tag="{x:Static models:DifficultyLevel.Custom}"/>
            </ComboBox>

            <StackPanel Visibility="{Binding IsCustomSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Custom Board" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Rows" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CustomRows, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Columns" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CustomColumns, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mines" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CustomMineCount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Border Visibility="{Binding ValidationError, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=NotNull}"
                        Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1"
                        CornerRadius="4" Padding="8,6" Margin="0,0,0,12">
                    <TextBlock Text="{Binding ValidationError}"
                               Foreground="#C62828" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Cell Size" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Slider Value="{Binding CellSize}" Minimum="24" Maximum="48"
                        Width="200" TickFrequency="4" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding CellSize}" Margin="12,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="px" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Content="Save &amp; Apply" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
