<UserControl x:Class="KPZ_FINAL.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WpfLibrary.models;assembly=WpfLibrary">

    <ScrollViewer Margin="24">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

            <TextBlock Text="📊 Statistics" FontSize="24" FontWeight="Bold"
                       FontFamily="Segoe UI Emoji"
                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,24"/>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#DDDDDD" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalGames}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Games" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalWins}" FontSize="28" FontWeight="Bold"
                                   Foreground="#43A047" HorizontalAlignment="Center"/>
                        <TextBlock Text="Wins" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalLosses}" FontSize="28" FontWeight="Bold"
                                   Foreground="#E53935" HorizontalAlignment="Center"/>
                        <TextBlock Text="Losses" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding WinRate, StringFormat={}{0}%}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Win Rate" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding AverageTime}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Avg Time" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="By Difficulty" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ComboBox SelectedValue="{Binding SelectedDifficulty}"
                      SelectedValuePath="Tag" Margin="0,0,0,12" Width="180" HorizontalAlignment="Left">
                <ComboBoxItem Content="🧪 Ultra Easy" Tag="{x:Static models:DifficultyLevel.UltraEasy}"/>
                <ComboBoxItem Content="Easy"          Tag="{x:Static models:DifficultyLevel.Easy}"/>
                <ComboBoxItem Content="Medium"        Tag="{x:Static models:DifficultyLevel.Medium}"/>
                <ComboBoxItem Content="Hard"          Tag="{x:Static models:DifficultyLevel.Hard}"/>
            </ComboBox>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#DDDDDD" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SelectedStats.Games}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Games" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SelectedStats.Wins}" FontSize="22" FontWeight="Bold"
                                   Foreground="#43A047" HorizontalAlignment="Center"/>
                        <TextBlock Text="Wins" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SelectedStats.WinRate, StringFormat={}{0}%}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Win Rate" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SelectedStats.FormattedBestTime}" FontSize="22" FontWeight="Bold"
                                   Foreground="#43A047" HorizontalAlignment="Center"/>
                        <TextBlock Text="Best Time" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SelectedStats.FormattedAvgTime}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Avg Time" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Button Content="Reset Statistics" Command="{Binding ResetCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    HorizontalAlignment="Left"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
