<UserControl x:Class="KPZ_FINAL.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WpfLibrary.Converters;assembly=WpfLibrary">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="#DDDDDD" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💣 " FontSize="16" VerticalAlignment="Center" FontFamily="Segoe UI Emoji"/>
                    <TextBlock Text="{Binding RemainingMines}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"
                               MinWidth="30" TextAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="{Binding FaceEmoji}"
                        Command="{Binding NewGameCommand}"
                        FontSize="22" Width="44" Height="44"
                        FontFamily="Segoe UI Emoji"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="{StaticResource SurfaceBrush}"
                        HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FormattedTime}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"
                               MinWidth="50" TextAlignment="Center"/>
                    <TextBlock Text=" ⏱" FontSize="16" VerticalAlignment="Center" FontFamily="Segoe UI Emoji"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Visibility="{Binding IsGameWon, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#E8F5E9" Padding="10" CornerRadius="5" Margin="0,0,0,10"
                BorderBrush="#A5D6A7" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🎉 Ви виграли! Введіть ім'я: " VerticalAlignment="Center"
                           FontWeight="SemiBold" FontFamily="Segoe UI Emoji"/>
                <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}"
                         Width="130" Margin="5,0" VerticalContentAlignment="Center"/>
                <Button Content="Зберегти рекорд"
                        Command="{Binding SaveScoreCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{Binding IsRecordSaved, Converter={StaticResource InverseBoolConverter}}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Visibility="{Binding IsGameLost, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#FFEBEE" Padding="10" CornerRadius="5" Margin="0,0,0,10"
                BorderBrush="#EF9A9A" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="💥 Ви програли! " VerticalAlignment="Center"
                           FontWeight="SemiBold" FontFamily="Segoe UI Emoji"/>
                <Button Content="Нова гра"
                        Command="{Binding NewGameCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}" Rows="{Binding Rows}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="1"
                                CornerRadius="3"
                                BorderThickness="1"
                                Cursor="Hand"
                                PreviewMouseRightButtonDown="Cell_PreviewMouseRightButtonDown"
                                Width="{Binding DataContext.CellSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Height="{Binding DataContext.CellSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}">

                            <Border.Background>
                                <MultiBinding Converter="{StaticResource CellBackgroundConverter}">
                                    <Binding Path="IsRevealed"/>
                                    <Binding Path="IsMine"/>
                                    <Binding Path="IsFlagged"/>
                                </MultiBinding>
                            </Border.Background>
                            <Border.BorderBrush>
                                <MultiBinding Converter="{StaticResource CellBackgroundConverter}">
                                    <Binding Path="IsRevealed"/>
                                    <Binding Path="IsMine"/>
                                    <Binding Path="IsFlagged"/>
                                </MultiBinding>
                            </Border.BorderBrush>

                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick"
                                              Command="{Binding DataContext.RevealCellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>

                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       FontFamily="Segoe UI Emoji">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=""/>
                                        <Setter Property="Foreground"
                                                Value="{Binding AdjacentMines, Converter={StaticResource NumberToColorConverter}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                                                <Setter Property="Text"       Value="🚩"/>
                                                <Setter Property="Foreground" Value="#E53935"/>
                                                <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsRevealed}" Value="True"/>
                                                    <Condition Binding="{Binding IsMine}"     Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="💣"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsRevealed}"  Value="True"/>
                                                    <Condition Binding="{Binding IsMine}"      Value="False"/>
                                                    <Condition Binding="{Binding ShowNumber}"  Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="{Binding AdjacentMines}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
