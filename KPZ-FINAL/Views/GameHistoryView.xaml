<UserControl x:Class="KPZ_FINAL.Views.GameHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🕹 Game History" FontSize="24" FontWeight="Bold"
                   FontFamily="Segoe UI Emoji"
                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="#DDDDDD" BorderThickness="1"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{Binding Entries.Count}" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Total" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="{Binding WinsCount}" FontSize="26" FontWeight="Bold"
                               Foreground="#43A047" HorizontalAlignment="Center"/>
                    <TextBlock Text="Wins" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding LossesCount}" FontSize="26" FontWeight="Bold"
                               Foreground="#E53935" HorizontalAlignment="Center"/>
                    <TextBlock Text="Losses" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="6" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"  Value="#FFF9C4"/>
                                    <Setter Property="BorderBrush" Value="#F9A825"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWon}" Value="True">
                                            <Setter Property="Background"  Value="#E8F5E9"/>
                                            <Setter Property="BorderBrush" Value="#A5D6A7"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Result}"
                                           FontFamily="Segoe UI Emoji"
                                           FontWeight="Bold" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Difficulty}"
                                           VerticalAlignment="Center" Foreground="#555"/>
                                <TextBlock Grid.Column="2" Text="{Binding FormattedTime}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding FormattedDate}"
                                           FontSize="11" Foreground="Gray" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="3" Content="Clear History" Command="{Binding ClearCommand}"
                Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left"/>
    </Grid>
</UserControl>
